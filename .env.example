# Copy this file to .env and fill in real values. Never commit real secrets.

# --- Database (provided by the platform) ---
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# --- App / auth ---
# Random long strings — generate with `openssl rand -hex 32`
JWT_SECRET=
CREDENTIAL_ENCRYPTION_KEY=
# Set to 1 only in local/dev sandboxes without a public HTTPS domain.
# NEVER enable this in a production deployment reachable by untrusted users.
ALLOW_DEV_LOGIN=0
NEXT_PUBLIC_ALLOW_DEV_LOGIN=0
# Public base URL of this deployment (used to build the Telegram media proxy
# URL handed to Instagram's Graph API, and OAuth default redirect URIs).
APP_BASE_URL=https://your-domain.example.com

# --- Telegram (see README "راه‌اندازی تلگرام") ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_ID=
OWNER_TELEGRAM_ID=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# Optional: secret Telegram sends back in a header when using webhooks
TELEGRAM_WEBHOOK_SECRET=

# --- YouTube (Google OAuth / Data API v3) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain.example.com/api/accounts/callback/youtube

# --- Instagram (Meta Graph API) ---
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://your-domain.example.com/api/accounts/callback/instagram

# --- Worker / cron ---
WORKER_TICK_INTERVAL_MS=60000
# Set to "1" to disable the in-process worker interval (e.g. if you run a
# separate worker process or an external cron hitting /api/cron/tick).
DISABLE_PUBLISH_WORKER=
# Shared secret required in the `x-cron-secret` header of POST /api/cron/tick
CRON_SECRET=
